# Database Connection (Neon Cloud PostgreSQL หรือ Local PostgreSQL)
# ตัวอย่างการเชื่อมต่อ Neon Cloud:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ตัวอย่างการเชื่อมต่อ Local PostgreSQL (ผ่าน Docker Compose):
# DATABASE_URL_UNPOOLED="postgresql://dev_user:dev_password@localhost:5433/product_db"

# พอร์ตสำหรับรัน Backend Server (ค่าเริ่มต้นคือ 5000)
PORT=5000
